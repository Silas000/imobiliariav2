# Bloquear execução de arquivos PHP na pasta de uploads
php_flag engine off

# Negar acesso a arquivos PHP
<Files "*.php">
    Order Deny,Allow
    Deny from all
</Files>
<Files "*.php5">
    Order Deny,Allow
    Deny from all
</Files>
<Files "*.phtml">
    Order Deny,Allow
    Deny from all
</Files>
